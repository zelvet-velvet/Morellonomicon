__pycache__/
*.pyc
.venv/
.env

# Obsidian: per-device state and downloaded plugins (python3 tools/install_plugins.py)
.obsidian/plugins/*
!.obsidian/plugins/morellonomicon/
.obsidian/plugins/morellonomicon/data.json
# Obsidian Git is committed too, so a fresh clone already has it (its settings stay per device)
!.obsidian/plugins/obsidian-git/
.obsidian/plugins/obsidian-git/data.json
# Vellum (layout editor, github.com/zelvet-velvet/vellum) is committed so the phone has it; update: python3 tools/install_plugins.py vellum
!.obsidian/plugins/vellum/
.obsidian/workspace.json
.obsidian/workspaces.json
**/.makemd/
**/.space/
.trash/
Tags/

# fetched data cache
.cache/

# your own numbers (tools/fetch_mastery.py): stay on this computer unless you decide to publish them
_data/mastery.json
